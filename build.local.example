# Per-machine build configuration. Copy to build.local (gitignored) and edit.
#
# build.local is sourced by build.sh before the build runs.

# Project Zomboid install directory — must contain projectzomboid.jar
# and ZombieBuddy.jar.
PZ_DIR="C:/Program Files (x86)/Steam/steamapps/common/ProjectZomboid"

# JDK with javac.exe/jar.exe. Either set this, or extract a Zulu JDK 25
# Windows x64 build into tools/ (build.sh picks it up automatically).
# JDK_DIR="C:/Program Files/Zulu/zulu-25"

# Where to install the built mod for local testing. Defaults to
# "$USERPROFILE/Zomboid/mods/ClearCanopy" if not set.
# MOD_INSTALL_ROOT="$USERPROFILE/Zomboid/mods/ClearCanopy"

# Optional: also sync to the Steam Workshop upload staging tree.
# PZ prefers the staging path over ~/Zomboid/mods/, so without this the
# two copies drift while testing.
# WORKSHOP_STAGE_MOD="$USERPROFILE/Zomboid/Workshop/ClearCanopy/Contents/mods/ClearCanopy"
